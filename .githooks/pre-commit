#!/bin/sh
#
# Blocks a commit that would break locale coverage.
#
# A missing or asymmetric translation key compiles fine and only shows up as a raw key
# ("admin.dossier.view") in front of a user — usually in Arabic, which is the default
# language and the one least likely to be spot-checked. This is the cheapest place to catch it.
#
# Enable in a fresh clone with:   git config core.hooksPath .githooks
# Skip once (rarely justified):   git commit --no-verify

set -e

# Nothing to check unless this commit touches the web app.
if ! git diff --cached --name-only | grep -q '^ordershieldpro-web/'; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not on PATH, skipping the locale check." >&2
  exit 0
fi

echo "pre-commit: checking locale coverage..."
if ! node ordershieldpro-web/tools/check-i18n.js; then
  cat >&2 <<'MSG'

Commit blocked: locale coverage failed.

Add the missing keys to ordershieldpro-web/src/assets/i18n/en.json and ar.json
(zh.json is deliberately not checked — Chinese is being dropped).

Re-run on demand with:  cd ordershieldpro-web && npm run check:i18n
MSG
  exit 1
fi
